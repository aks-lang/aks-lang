fn RunFastMathTests() {
    let arr1 = [1.0, 4.0, 9.0, 16.0, 25.0, 36.0, 49.0, 64.0];
    let sqrts = FastMath.SqrtVec8f(arr1);

    assert_eq(Length(sqrts), 8);
    assert_eq(sqrts[0], 1.0);
    assert_eq(sqrts[1], 2.0);
    assert_eq(sqrts[2], 3.0);
    assert_eq(sqrts[3], 4.0);
    assert_eq(sqrts[4], 5.0);
    assert_eq(sqrts[5], 6.0);
    assert_eq(sqrts[6], 7.0);
    assert_eq(sqrts[7], 8.0);

    let arr2 = [10.0, 2.0, 30.0, 4.0, 50.0, 6.0, 70.0, 8.0];
    let mins = FastMath.MinVec8f(arr1, arr2);
    assert_eq(mins[0], 1.0);
    assert_eq(mins[1], 2.0);
    assert_eq(mins[2], 9.0);

    let maxs = FastMath.MaxVec8f(arr1, arr2);
    assert_eq(maxs[0], 10.0);
    assert_eq(maxs[1], 4.0);
    assert_eq(maxs[2], 30.0);

    println("SIMD vectorized mathematical functions tests passed successfully");
}

RunFastMathTests();
