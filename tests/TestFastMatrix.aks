fn RunFastMatrixTests() {
    let ident = FastMatrix.Identity();
    assert_eq(Length(ident), 16);
    assert_eq(ident[0], 1.0);
    assert_eq(ident[1], 0.0);
    assert_eq(ident[5], 1.0);
    assert_eq(ident[10], 1.0);
    assert_eq(ident[15], 1.0);

    // Matrix multiplication with identity yields unchanged matrix
    let prod = FastMatrix.Multiply(ident, ident);
    assert_eq(Length(prod), 16);
    assert_eq(prod[0], 1.0);
    assert_eq(prod[5], 1.0);
    assert_eq(prod[10], 1.0);
    assert_eq(prod[15], 1.0);

    // Transform 4D vector with identity matrix
    let vec = [2.0, 3.0, 4.0, 1.0];
    let transformed = FastMatrix.TransformVec4(ident, vec);
    assert_eq(Length(transformed), 4);
    assert_eq(transformed[0], 2.0);
    assert_eq(transformed[1], 3.0);
    assert_eq(transformed[2], 4.0);
    assert_eq(transformed[3], 1.0);

    // Transpose identity matrix
    let transposed = FastMatrix.Transpose(ident);
    assert_eq(Length(transposed), 16);
    assert_eq(transposed[0], 1.0);
    assert_eq(transposed[5], 1.0);

    println("SIMD 4x4 matrix mathematics tests passed successfully");
}

RunFastMatrixTests();
