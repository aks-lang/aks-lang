println("Exhaustive Math Subsystem Test Suite");

let stats = [0, 0];

fn pass(name, st) {
    println("  [PASS] " + name);
    st[0] = st[0] + 1;
}

fn fail(name, extra, st) {
    println("  [FAIL] " + name + " (" + extra + ")");
    st[1] = st[1] + 1;
}

fn assert_eq(actual, expected, name, st) {
    if (actual == expected) {
        pass(name, st);
    } else {
        fail(name, "expected " + String(expected) + ", got " + String(actual), st);
    }
}

// Basic Arithmetic & Absolute Functions
println("\n1. Basic Arithmetic & Absolute Functions");
assert_eq(Absolute(-42), 42, "abs(-42) == 42", stats);
assert_eq(Absolute(42), 42, "abs(42) == 42", stats);
assert_eq(Absolute(-3.14), 3.14, "abs(-3.14) == 3.14", stats);

assert_eq(Minimum(10, 20), 10, "min(10, 20) == 10", stats);
assert_eq(Minimum(-5, -15), -15, "min(-5, -15) == -15", stats);
assert_eq(Maximum(10, 20), 20, "max(10, 20) == 20", stats);
assert_eq(Maximum(-5, -15), -5, "max(-5, -15) == -5", stats);

// Power & Roots (sqrt, pow)
println("\n2. Power & Roots");
assert_eq(SquareRoot(16.0), 4.0, "sqrt(16.0) == 4.0", stats);
assert_eq(SquareRoot(144.0), 12.0, "sqrt(144.0) == 12.0", stats);
assert_eq(Power(2.0, 3.0), 8.0, "pow(2.0, 3.0) == 8.0", stats);
assert_eq(Power(10.0, 2.0), 100.0, "pow(10.0, 2.0) == 100.0", stats);

// Rounding Functions (floor, ceil, round)
println("\n3. Rounding Functions");
assert_eq(floor(3.89), 3, "floor(3.89) == 3", stats);
assert_eq(floor(-3.14), -4, "floor(-3.14) == -4", stats);
assert_eq(Ceiling(3.14), 4, "ceil(3.14) == 4", stats);
assert_eq(Ceiling(-3.89), -3, "ceil(-3.89) == -3", stats);
assert_eq(round(3.49), 3, "round(3.49) == 3", stats);
assert_eq(round(3.51), 4, "round(3.51) == 4", stats);

// Trigonometric & Exponential Functions
println("\n4. Trigonometric & Exponential Functions");
assert_eq(sin(0.0), 0.0, "sin(0.0) == 0.0", stats);
assert_eq(cos(0.0), 1.0, "cos(0.0) == 1.0", stats);
assert_eq(tan(0.0), 0.0, "tan(0.0) == 0.0", stats);
assert_eq(log(1.0), 0.0, "log(1.0) == 0.0", stats);
assert_eq(exp(0.0), 1.0, "exp(0.0) == 1.0", stats);

// Randomness Function (rand)
println("\n5. Randomness Function");
let r = Random();
assert_eq(typeof(r) == "float" || typeof(r) == "int", true, "rand() returns numeric value", stats);

println("Passed: " + String(stats[0]));
println("Failed: " + String(stats[1]));

if (stats[1] == 0) {
    println("All " + String(stats[0]) + " math subsystem tests passed successfully.");
} else {
    println("Test suite failed.");
    exit(1);
}
