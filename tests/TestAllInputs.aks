print("Enter an integer:");
input(intText);
let intValue = intText as int;
print("Integer read: " + String(intValue));

print("Enter a float:");
input(floatText);
let floatValue = floatText as float;
print("Float read: " + String(floatValue));

print("Enter a boolean (true/false):");
input(boolText);
let boolValue = boolText as bool;
print("Boolean read: " + String(boolValue));

print("Enter some text:");
input(stringValue);
print("String read: " + stringValue);
