fn RunAutoDiffTests() {
    let d1 = Dual(3.0, 1.0);
    let d2 = Dual(2.0, 0.0);

    let dSum = d1.Add(d2);
    assert_eq(dSum.val, 5.0);
    assert_eq(dSum.grad, 1.0);

    let dProd = d1.Mul(d2);
    assert_eq(dProd.val, 6.0);
    assert_eq(dProd.grad, 2.0);

    let dSquare = d1.Mul(d1);
    assert_eq(dSquare.val, 9.0);
    assert_eq(dSquare.grad, 6.0);

    let dPoly = (d1.Mul(d1)).Add(d1.Mul(Dual(5.0, 0.0)));
    assert_eq(dPoly.val, 24.0);
    assert_eq(dPoly.grad, 11.0);

    let f1 = fn(x) { return x * x + (3.0 * x) + 5.0; };
    let df1 = grad(f1, 4.0);
    assert_eq(df1, 11.0);

    let df2 = grad(fn(x) { return x * x * x; }, 2.0);
    assert_eq(df2, 12.0);

    let jvpResult = jvp(fn(x) { return x * x; }, 3.0, 2.0);
    assert_eq(jvpResult, 12.0);

    println("Native automatic differentiation tests passed successfully");
}

RunAutoDiffTests();
