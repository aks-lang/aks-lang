// Test suite for JIT linear scan register allocation and on-stack replacement (OSR)

fn compute_triangular_sum(limit) {
    let acc = 0;
    let i = 1;
    while (i <= limit) {
        acc = acc + i;
        i = i + 1;
    }
    return acc;
}

fn compute_nested_loop(outer, inner) {
    let total = 0;
    let i = 0;
    while (i < outer) {
        let j = 0;
        while (j < inner) {
            total = total + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    return total;
}

fn main() {
    print("Test 1: Hot Loop OSR and Register-Allocated Accumulator");
    // 500 iterations easily triggers hot-loop JIT tiering (threshold 50) and OSR mid-loop
    let sum500 = compute_triangular_sum(500);
    print("Triangular sum(500) = " + String(sum500) + " (expected 125250)");

    if (sum500 == 125250) {
        print("PASS: Hot loop executed with JIT tiering, OSR, and register allocation");
    } else {
        print("FAIL: Expected 125250, got " + String(sum500));
        exit(1);
    }

    print("Test 2: Nested JIT Hot Loop Tiering");
    let nested_res = compute_nested_loop(100, 50);
    print("Nested loop result = " + String(nested_res) + " (expected 5000)");

    if (nested_res == 5000) {
        print("PASS: Nested hot loops compiled and executed cleanly");
    } else {
        print("FAIL: Expected 5000, got " + String(nested_res));
        exit(1);
    }

    print("All JIT OSR and Register Allocation Tests PASSED cleanly");
}

main();
