fn Assert(cond, msg) {
    if (!cond) {
        panic(msg);
    }
}

fn AssertEq(actual, expected, msg) {
    if (actual != expected) {
        panic(msg);
    }
}

fn TestComptimeBasic() {
    let x = comptime {
        let a = 10;
        let b = 20;
        return a + b;
    };
    AssertEq(x, 30, "Comptime basic failed");
}

fn TestComptimeArithmetic() {
    let y = comptime {
        let sum = 0;
        let i = 1;
        while (i <= 5) {
            sum = sum + i;
            i++;
        }
        return sum;
    };
    AssertEq(y, 15, "Comptime loop failed");
}

fn Main() {
    print("Running Comptime Execution Tests");
    TestComptimeBasic();
    TestComptimeArithmetic();
    print("Comptime Execution Tests Passed");
}

Main();
