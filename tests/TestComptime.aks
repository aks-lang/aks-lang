fn Factorial(n) {
    if (n <= 1) {
        return 1;
    }
    return n * Factorial(n - 1);
}

fn TestComptime() {
    println("Testing comptime CTFE execution...");
    let fact10 = comptime Factorial(10);
    println("Comptime factorial(10): " + fact10);
    assert(fact10 == 3628800.0, "Comptime factorial(10) mismatch!");

    let computed = comptime {
        let sum = 0;
        for (let i = 1; i <= 100; i = i + 1) {
            sum = sum + i;
        }
        return sum;
    };
    println("Comptime sum(1..100): " + computed);
    assert(computed == 5050, "Comptime loop sum mismatch!");

    println("Comptime tests passed successfully!");
}

TestComptime();
