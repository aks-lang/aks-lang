// TestArenaPromotion.aks - Verify Automatic Task Bump-Arena Promotion via Escape Analysis

struct Point {
    x: int;
    y: int;
}

fn ComputeLocalArr(a, b) {
    let arr = [a, b, a + b, a * b];
    let sum = 0;
    for (let i = 0; i < Length(arr); i = i + 1) {
        sum = sum + arr[i];
    }
    return sum;
}

fn ComputeLocalTuple(x, y) {
    let t = (x + 10, y + 20);
    return t[0] + t[1];
}

fn ComputeLocalStruct(px, py) {
    let pt = Point { x: px * 2, y: py * 3 };
    return pt.x + pt.y;
}

fn ComputeNested() {
    let total = 0;
    for (let i = 0; i < 50000; i = i + 1) {
        let s1 = ComputeLocalArr(i, 2);
        let s2 = ComputeLocalTuple(i, 3);
        let s3 = ComputeLocalStruct(i, 4);
        total = total + (s1 & 1) + (s2 & 1) + (s3 & 1);
    }
    return total;
}

print("Testing automatic bump-arena allocation for non-escaping locals...");

let r1 = ComputeLocalArr(3, 4);
assert(r1 == (3 + 4 + 7 + 12), "Local array sum check");

let r2 = ComputeLocalTuple(5, 6);
assert(r2 == (15 + 26), "Local tuple check");

let r3 = ComputeLocalStruct(10, 20);
assert(r3 == (20 + 60), "Local struct check");

let r4 = ComputeNested();
assert(r4 >= 0, "Stress throughput check");

print("PASS: All bump-arena promotion tests passed with 0 leaks!");
