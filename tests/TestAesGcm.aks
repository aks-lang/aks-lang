fn RunAesGcmTests() {
    let keyHex = "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f";
    let ivHex = "000000000000000000000001";
    let plaintext = "AKS High Performance Systems Secure Authenticated Communication Engine";
    let authData = "header_signature_v1";

    // Encrypt
    let encryptedHex = AesGcm.Encrypt(keyHex, ivHex, plaintext, authData);
    assert_eq(encryptedHex != null, true);
    assert_eq(Length(encryptedHex) > 32, true);

    // Decrypt with valid auth data
    let decrypted = AesGcm.Decrypt(keyHex, ivHex, encryptedHex, authData);
    assert_eq(decrypted, plaintext);

    // Decrypt with invalid auth data fails (returns null)
    let invalidDecrypted = AesGcm.Decrypt(keyHex, ivHex, encryptedHex, "corrupted_auth_data");
    assert_eq(invalidDecrypted, null);

    println("Authenticated AES-256-GCM symmetric encryption tests passed successfully");
}

RunAesGcmTests();
