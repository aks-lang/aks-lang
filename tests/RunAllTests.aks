let integration_suites = [
    { name: "Borrow Checker Suite", cmd: ".\\tests\\BorrowCheckerTests.exe" },
    { name: "Packaging Suite", cmd: "cmd.exe /c tests\\PackagingTest.bat" },
    { name: "Developer Tools Suite", cmd: "python tests\\ToolsTest.py" },
    { name: "LSP Server Suite", cmd: "python tests\\TestLsp.py" },
    { name: "DAP Debugger Suite", cmd: "python tests\\TestDap.py" }
];

let total = Length(tests) + Length(integration_suites);
let passed = 0;
let failed = 0;
let idx = 1;

// Run all individual test scripts
for (let i = 0; i < Length(tests); i++) {
    let t = tests[i];
    let file = "tests/" + t.name;
    print("[" + String(idx) + "/" + String(total) + "] Running: " + file);
    idx = idx + 1;

    let flag_str = "";
    if (t.flags != "") {
        flag_str = t.flags + " ";
    }
    
    let in_pipe = "< nul";
    if (t.in_file != null && t.in_file != "") {
        in_pipe = "< " + t.in_file;
    }
    
    let cmd = ".\\aks.exe run " + flag_str + "tests\\" + t.name + " " + in_pipe + " 2>&1";

    let t0 = clock();
    let out = Execute(cmd);
    let dur = clock() - t0;

    let is_fail = false;
    if (t.expect_fail != null && t.expect_fail == true) {
        is_fail = true;
    }
    let has_leak = str_contains(out, "Memory leak warning:");
    let has_error = str_contains(out, "Compiler error:") || str_contains(out, "Compiler error on line") || str_contains(out, "Runtime error:") || str_contains(out, "Unhandled exception in __main__") || str_contains(out, "ASSERTION FAILED") || str_contains(out, "Security error:");

    let test_ok = true;
    if (is_fail) {
        if (!has_error) {
            test_ok = false;
        }
    } else {
        if (has_error || has_leak) {
            test_ok = false;
        }
    }

    let dur_str = String(round(dur * 100) / 100);
    if (test_ok) {
        passed = passed + 1;
        let status_msg = "Passed";
        if (is_fail) {
            status_msg = "Passed (expected failure)";
        }
        print("  -> PASS | " + status_msg + " | 0 leaks (" + dur_str + "s)");
    } else {
        failed = failed + 1;
        let leak_msg = "0 leaks";
        if (has_leak) {
            leak_msg = "Memory Leaks Detected";
        }
        print("  -> FAIL | Execution failed | " + leak_msg + " (" + dur_str + "s)");
    }
}

// Run all integration suites
for (let i = 0; i < Length(integration_suites); i++) {
    let suite = integration_suites[i];
    print("[" + String(idx) + "/" + String(total) + "] Running: " + suite.name);
    idx = idx + 1;

    let t0 = clock();
    let out = Execute(suite.cmd + " 2>&1");
    let dur = clock() - t0;

    let has_leak = str_contains(out, "Memory leak warning:");
    let has_fail = false;
    if (str_contains(out, "FAILED") || str_contains(out, "Build failed") || str_contains(out, "error:") || str_contains(out, "Error:")) {
        if (!str_contains(out, "0 Failed") && !str_contains(out, "0 failed") && !str_contains(out, "14 Passed")) {
            has_fail = true;
        }
    }

    let dur_str = String(round(dur * 100) / 100);
    if (!has_fail && !has_leak) {
        passed = passed + 1;
        print("  -> PASS | Passed | 0 leaks (" + dur_str + "s)");
    } else {
        failed = failed + 1;
        print("  -> FAIL | Suite failed | (" + dur_str + "s)");
    }
}

// Auto-clean residual temporary files
RemoveFile("akscoredump.json");
RemoveFile("PlotOutput.svg");
RemoveFile("ChartOutput.svg");
RemoveFile("dap_pause_dump.txt");
RemoveFile("TestIoOutput.txt");
RemoveFile("SystemOutput.txt");
RemoveFile("AsyncIoOutput.txt");
RemoveFile("AsyncIoDeepOutput.txt");
RemoveFile("outtarget.c.map");
Execute("cmd.exe /c del /f /q jittrace*.* *.svg tests\\*.svg 2>nul & rd /s /q LibraryTestDir templibrarydir mylib myapp 2>nul");

print("\nSummary: " + String(passed) + "/" + String(total) + " tests passed.");
if (failed == 0) {
    print("All tests passed successfully (0 errors, 0 memory leaks).");
} else {
    print(String(failed) + " test(s) failed.");
}
