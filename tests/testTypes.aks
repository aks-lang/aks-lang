// New enhancement tests
print("Testing new enhancements");

// Interface Default Methods
print("Testing default interface methods");
interface Greetable {
    fn greet() -> void {
        print("Hello from default interface method!");
    }
}
struct Person implements Greetable {}
let p1 = new Person();
p1.greet();
// should call default body and print "Hello from default interface method!"

// ADT Trait Derivations (toString / eq)
print("Testing ADT derives");
let c1 = Shape.Circle(10);
let c2 = Shape.Circle(10);
let c3 = Shape.Circle(12);
let pt = Shape.Point();

print("Shape c1: " + Shape.ToString(c1));
// circle(10)
print("Shape pt: " + Shape.ToString(pt));
// point
print("c1 == c2: " + String(Shape.Eq(c1, c2)));
// true
print("c1 == c3: " + String(Shape.Eq(c1, c3)));
// false

// Intersection runtime checking failure
print("Testing intersection runtime type checks");
struct NonFlyer implements Drivable {
    drive: fn(int) -> void;
}
let nf = new NonFlyer();
nf.drive = fn(speed: int) {};
try {
    let badhybrid: Drivable & Flyable = nf;
    print("FAILED: expected runtime intersection error");
}catch (err) {
    print("Caught expected intersection runtime type error: " + err);
}

// Type narrowing inside branches
print("Testing branch type narrowing");
let valnarrow: int = 5;
if (valnarrow > 0) {
    let positiveval: int {v: v > 0} = valnarrow;
    // should check out at compile time!
    print("Type narrowing success: positiveval = " + String(positiveval));
}

// Non-exhaustive match warning demo (compiling this triggers the compiler warning)
print("Testing non-exhaustive match warning");
enum Color {
    Red,
    Green,
    Blue
};
fn checkExhaustiveness(col: Color) {
    match (col) {
        Color.Red => {print("Red");
        }
    }
}

print("type system verified");
