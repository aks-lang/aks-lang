print("testing type system");

// Interfaces & Explicit Implements
print("Testing interfaces");
interface Drivable {
    fn drive(speed: int) -> void;
}

interface Flyable {
    fn fly(altitude: int) -> void;
}

struct Car implements Drivable {
    drive: fn(int) -> void;
}

struct FlyingCar implements Drivable, Flyable {
    drive: fn(int) -> void;
    fly: fn(int) -> void;
}

fn driveCar(d: Drivable, s: int) {
    d.drive(s);
}

let myCar = new Car();
myCar.drive = fn(speed: int) {
    print("Driving car at speed: " + String(speed));
};

// test interface compatibility check
driveCar(myCar, 60);

// Generics (Struct Templates & Monomorphization)
print("Testing generics");
struct Box < T > {
    value: T;
}

let intBox = new Box < int > ();
intBox.value = 42;
print("intBox value: " + String(intBox.value));

let strBox = new Box < string > ();
strBox.value = "Hello Generics";
print("strBox value: " + strBox.value);

// Union Types
print("Testing union types");
fn processUnion(val: int | string) {
    print("Processing union value: " + String(val));
}
processUnion(100);
processUnion("AKS Type System");

// Intersection Types & Structural Compatibility
print("Testing intersection types");
let myFC = new FlyingCar();
myFC.drive = fn(speed: int) {
    print("FlyingCar driving at speed: " + String(speed));
};
myFC.fly = fn(alt: int) {
    print("FlyingCar flying at altitude: " + String(alt));
};

// flyingCar matches intersection of Drivable & Flyable
let hybrid: Drivable & Flyable = myFC;
hybrid.drive(80);
hybrid.fly(500);

// Algebraic Data Types & Pattern Matching
print("Testing ADTs and pattern matching");
enum Shape {
    Circle(int),
    Rectangle(int, int),
    Point
};

fn describeShape(s: Shape) {
    match (s) {
        Shape.Circle(r) => {
            print("Area of Circle: " + String(3 * r * r));
        },
        Shape.Rectangle(w, h) => {
            print("Area of Rectangle: " + String(w * h));
        },
        Shape.Point => {
            print("It is a Point!");
        }
    }
}

let c = Shape.Circle(10);
let r = Shape.Rectangle(5, 8);
let p = Shape.Point();

describeShape(c);
describeShape(r);
describeShape(p);

// Dependent / Refinement Types
print("Testing dependent / refinement types");
fn positiveSquare(x: int {val: val > 0}) -> int {res: res > x} {
    return x * x + 1;
}

let posVal: int {x: x >= 10} = 15;
print("posVal: " + String(posVal));

let result = positiveSquare(posVal);
print("positiveSquare result: " + String(result));

