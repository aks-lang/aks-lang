print("AKS Language Full Feature Test Suite");

let stats = [0, 0]; // [0] = pass, [1] = fail

fn pass(name, st) {
    print("  [PASS] " + name);
    st[0] = st[0] + 1;
}

fn fail(name, st) {
    print("  [FAIL] " + name);
    st[1] = st[1] + 1;
}

fn assert_eq(actual, expected, name, st) {
    if (actual == expected) {
        pass(name, st);
    } else {
        print("  (expected " + String(expected) + ", got " + String(actual) + ")");
        fail(name, st);
    }
}

fn assert_true(cond, name, st) {
    if (cond) {
        pass(name, st);
    } else {
        fail(name, st);
    }
}

// Arithmetic & bitwise operators
print("\n1. Arithmetic & Bitwise Operations");
assert_eq(10 + 20, 30, "Integer Addition", stats);
assert_eq(50 - 18, 32, "Integer Subtraction", stats);
assert_eq(6 * 7, 42, "Integer Multiplication", stats);
assert_eq(100 / 4, 25, "Integer Division", stats);
assert_eq(17 % 5, 2, "Integer Modulo", stats);

assert_eq(3.5 + 2.5, 6.0, "Float Addition", stats);
assert_eq(10.5 - 2.5, 8.0, "Float Subtraction", stats);
assert_eq(2.5 * 4.0, 10.0, "Float Multiplication", stats);
assert_eq(7.5 / 2.5, 3.0, "Float Division", stats);

assert_eq(1 + 2 * 3, 7, "Operator Precedence (* over +)", stats);
assert_eq((1 + 2) * 3, 9, "Parentheses Precedence", stats);

assert_eq(12 & 10, 8, "Bitwise AND (12 & 10)", stats);
assert_eq(12 | 10, 14, "Bitwise OR (12 | 10)", stats);
assert_eq(12 ^ 10, 6, "Bitwise XOR (12 ^ 10)", stats);
assert_eq(1 << 4, 16, "Bitwise Left Shift (1 << 4)", stats);
assert_eq(32 >> 2, 8, "Bitwise Right Shift (32 >> 2)", stats);

// Comparison & logical operators
print("\n2. Comparisons & Logical Operators");
assert_true(10 == 10, "Equal (10 == 10)", stats);
assert_true(10 != 20, "Not Equal (10 != 20)", stats);
assert_true(5 < 10, "Less Than (5 < 10)", stats);
assert_true(10 > 5, "Greater Than (10 > 5)", stats);
assert_true(5 <= 5, "Less Or Equal (5 <= 5)", stats);
assert_true(5 >= 5, "Greater Or Equal (5 >= 5)", stats);

assert_true(true && true, "Logical AND (true && true)", stats);
assert_true(!(true && false), "Logical AND (true && false -> false)", stats);
assert_true(true || false, "Logical OR (true || false)", stats);
assert_true(!false, "Logical NOT (!false)", stats);

// Control flow & loops
print("\n3. Control Flow & Loops");

let branch = 0;
let val = 15;
if (val > 20) {
    branch = 1;
} else if (val == 15) {
    branch = 2;
} else {
    branch = 3;
}
assert_eq(branch, 2, "If / Else-If / Else Branching", stats);

// While loop
let sum = 0;
let i = 1;
while (i <= 5) {
    sum = sum + i;
    i++;
}
assert_eq(sum, 15, "While Loop Sum (1..5)", stats);

// While loop with break & continue
let evensum = 0;
let j = 0;
while (j < 10) {
    j++;
    if (j % 2 != 0) { continue; }
    if (j > 6) { break; }
    evensum = evensum + j;
}
assert_eq(evensum, 12, "Loop Break & Continue (2 + 4 + 6)", stats);

// Array Iteration
let arrsum = 0;
let numbers = [10, 20, 30];
let k = 0;
while (k < Length(numbers)) {
    arrsum = arrsum + numbers[k];
    k++;
}
assert_eq(arrsum, 60, "Array Iteration Loop", stats);

// Switch Statement
let sw_res = 0;
let target = 2;
switch (target) {
    case 1: sw_res = 100;
    case 2: sw_res = 200;
    default: sw_res = 999;
}
assert_eq(sw_res, 200, "Switch / Case Statement", stats);

// Data STRUCTURES (Arrays, Tuples, Structs, Enums)
print("\n4. Data Structures");

// Array operations
let arr = [1, 2, 3];
append(arr, 4);
assert_eq(Length(arr), 4, "Array len() after append()", stats);
assert_eq(arr[3], 4, "Array Indexing", stats);
arr[0] = 99;
assert_eq(arr[0], 99, "Array Element Mutation", stats);

// Tuples
let tup = (10, "hello", true);
assert_eq(tup[0], 10, "Tuple Element 0", stats);
assert_eq(tup[1], "hello", "Tuple Element 1", stats);
assert_eq(tup[2], true, "Tuple Element 2", stats);

// Structs
struct Person {
    name: string;
    age: int;
}
fn Person.greet(self) {
    return "Hello, " + self.name + " (" + String(self.age) + ")";
}

let p = new Person();
p.name = "Alice";
p.age = 30;
assert_eq(p.name, "Alice", "Struct Field Read (name)", stats);
assert_eq(p.age, 30, "Struct Field Read (age)", stats);
assert_eq(p.greet(), "Hello, Alice (30)", "Struct Method Invocation", stats);

// Enums & Pattern Matching
enum Shape {
    Circle(float),
    Rectangle(float, float)
};

fn area(shape) {
    let res = 0.0;
    match (shape) {
        case Shape.Circle(r) => { res = 3.14 * r * r; }
        case Shape.Rectangle(w, h) => { res = w * h; }
    }
    return res;
}

let c = Shape.Circle(2.0);
let r = Shape.Rectangle(4.0, 5.0);
assert_eq(area(c), 12.56, "Enum Match (Circle area)", stats);
assert_eq(area(r), 20.0, "Enum Match (Rectangle area)", stats);

// Functions, recursion & prelude higher-order functions
print("\n5. Functions & Prelude Helpers");

fn factorial(n) {
    if (n <= 1) { return 1; }
    return n * factorial(n - 1);
}
assert_eq(factorial(5), 120, "Recursive Factorial (5!)", stats);

// Prelude higher-order functions: map, filter, reduce, range
let nums = range(1, 6); // [1, 2, 3, 4, 5]
assert_eq(Length(nums), 5, "Prelude range(1, 6) length", stats);

let doubled = map(nums, fn(x) { return x * 2; }); // [2, 4, 6, 8, 10]
assert_eq(doubled[0], 2, "Prelude map() double element 0", stats);
assert_eq(doubled[4], 10, "Prelude map() double element 4", stats);

let evens = filter(nums, fn(x) { return x % 2 == 0; }); // [2, 4]
assert_eq(Length(evens), 2, "Prelude filter() evens length", stats);
assert_eq(evens[0], 2, "Prelude filter() element 0", stats);

let total = reduce(nums, fn(acc, x) { return acc + x; }, 0); // 
assert_eq(total, 15, "Prelude reduce() sum", stats);

let reversed_nums = reverse([1, 2, 3]);
assert_eq(reversed_nums[0], 3, "Prelude reverse() element 0", stats);

let joined_str = join(["a", "b", "c"], "-");
assert_eq(joined_str, "a-b-c", "Prelude join()", stats);

// Exception handling
print("\n6. Exception Handling");

try {
    throw "Custom Error Message";
    fail("Throw & Catch Custom Exception", stats);
}catch (err) {
    if (err == "Custom Error Message") {
        pass("Throw & Catch Custom Exception", stats);
    } else {
        fail("Throw & Catch Custom Exception (wrong message)", stats);
    }
}

try {
    let str_val = "AKS";
    str_val++;
    fail("Catch Runtime Non-Numeric Increment Exception", stats);
}catch (err) {
    pass("Catch Runtime Non-Numeric Increment Exception", stats);
}

// String & JSON serialization
print("\n7. String & Serialization");

let s1 = "Hello, ";
let s2 = "World!";
assert_eq(s1 + s2, "Hello, World!", "String Concatenation", stats);
assert_eq(Length(s1 + s2), 13, "String Length", stats);

let sample_obj = { name: "Bob", age: 25 };
let obj_dict = JsonParse(JsonStringify(sample_obj));
assert_eq(obj_dict.name, "Bob", "JSON Parse Object Field (name)", stats);
assert_eq(obj_dict.age, 25, "JSON Parse Object Field (age)", stats);

let json_str = JsonStringify(obj_dict);
assert_true(Length(json_str) > 0, "JSON Stringify Output", stats);

// Concurrency & channels
print("\n8. Concurrency & Channels");

let ch = Channel(5);
send(ch, 42);
send(ch, 99);
let msg1 = Receive(ch);
let msg2 = Receive(ch);
assert_eq(msg1, 42, "Channel Send / Recv 1", stats);
assert_eq(msg2, 99, "Channel Send / Recv 2", stats);

// Final results summary
print("Passed: " + String(stats[0]));
print("Failed: " + String(stats[1]));

if (stats[1] > 0) {
    print("FULL LANGUAGE TEST SUITE FAILED!");
    exit(1);
} else {
    print("All 60 language feature tests passed successfully.");
}
