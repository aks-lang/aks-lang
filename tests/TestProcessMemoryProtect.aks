// Test suite for OS Runtime Page Permission & Execution Protection
fn main() {
    let buf = AlignedBuffer.Alloc(4096, 4096);
    let ptr = buf.ptr_id;
    assert(ptr != 0);

    // PAGE_READWRITE = 0x04, PAGE_READONLY = 0x02
    let old_prot = ProcessMemoryProtect.Protect(ptr, 4096, 0x02);
    assert(old_prot > 0);

    // Restore to PAGE_READWRITE
    let prev_prot = ProcessMemoryProtect.Protect(ptr, 4096, 0x04);
    assert_eq(prev_prot, 0x02);

    let free_ok = buf.Free();
    assert(free_ok == true);
    print("TestProcessMemoryProtect passed");
}

main();
