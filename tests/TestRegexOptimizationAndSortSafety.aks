// TestRegexOptimizationAndSortSafety.aks
// Verifies zero-allocation Regex backtracking, dynamic regex expansion,
// cross-platform 64-bit integer parsing, slice COW sort safety, and mixed numeric sort.

fn TestRegexBacktrackingAndScale() {
    let pat = "[0-9]+";
    let text = "sample123456789data0987654321end";
    
    // Exercise MatchNFA stack saves across multiple iterations
    let i = 0;
    while (i < 50) {
        let m = RegexMatch(pat, "12345678");
        assert(m == true);
        let s = RegexSearch(pat, text);
        assert(s != null);
        i++;
    }
    println("TestRegexBacktrackingAndScale PASSED");
}

fn TestRegexReplaceDynamicExpansion() {
    // Generate a long text that exceeds 8,000 characters to test dynamic buffer growth
    let chunk = "0123456789itemX0123456789itemX0123456789itemX0123456789itemX0123456789itemX";
    let b1 = chunk + chunk + chunk + chunk;
    let b2 = b1 + b1 + b1 + b1;
    let b3 = b2 + b2 + b2 + b2;
    let big_text = b3 + b3; // ~9,700 bytes
    assert(Length(big_text) > 9000);

    // Replace "X" with "REPLACED_EXTRA_LONG"
    // Total output will expand to ~15,000+ bytes without silent truncation
    let replaced = RegexReplaceC("X", "REPLACED_EXTRA_LONG", big_text);
    assert(Length(replaced) > 15000);
    assert(find(replaced, "REPLACED_EXTRA_LONG") >= 0);
    assert(find(replaced, "itemX") < 0);
    println("TestRegexReplaceDynamicExpansion PASSED");
}

fn TestRegexSplitDirect() {
    let fruit_data = "apple,banana,cherry,date,elderberry";
    let parts = RegexSplitC(",", fruit_data);
    assert(Length(parts) == 5);
    assert(parts[0] == "apple");
    assert(parts[1] == "banana");
    assert(parts[2] == "cherry");
    assert(parts[3] == "date");
    assert(parts[4] == "elderberry");
    println("TestRegexSplitDirect PASSED");
}

fn Test64BitParsersAndUnicode() {
    // 1. JSONParseC with 64-bit integer > 2^31 and unicode escapes
    let json_str = """{"large_id": 10000000000, "greeting": "\u0048\u0065\u006c\u006c\u006f"}""";
    let parsed_json = JSONParseC(json_str);
    assert(parsed_json != null);
    assert(parsed_json.large_id == 10000000000);
    assert(parsed_json.greeting == "Hello");

    // 2. TOMLParseC with 64-bit integer
    let toml_str = "timestamp = 1789987654321\ntitle = \"AKS Test\"\n";
    let parsed_toml = TOMLParseC(toml_str);
    assert(parsed_toml != null);
    assert(parsed_toml.timestamp == 1789987654321);
    assert(parsed_toml.title == "AKS Test");
    println("Test64BitParsersAndUnicode PASSED");
}

fn TestSliceSortCowSafety() {
    let parent = [50, 40, 30, 20, 10];
    let sl = parent[1 .. 4]; // [40, 30, 20]
    assert(Length(sl) == 3);
    assert(sl[0] == 40 && sl[1] == 30 && sl[2] == 20);

    // Sort slice
    sort(sl);
    assert(sl[0] == 20 && sl[1] == 30 && sl[2] == 40);

    // Parent must remain completely intact due to COW detachment
    assert(parent[0] == 50);
    assert(parent[1] == 40);
    assert(parent[2] == 30);
    assert(parent[3] == 20);
    assert(parent[4] == 10);
    println("TestSliceSortCowSafety PASSED");
}

fn TestMixedNumericSort() {
    let mix = [10, 2.5, -1, 3.14, 0];
    sort(mix);
    assert(mix[0] == -1);
    assert(mix[1] == 0);
    assert(mix[2] == 2.5);
    assert(mix[3] == 3.14);
    assert(mix[4] == 10);
    println("TestMixedNumericSort PASSED");
}

TestRegexBacktrackingAndScale();
TestRegexReplaceDynamicExpansion();
TestRegexSplitDirect();
Test64BitParsersAndUnicode();
TestSliceSortCowSafety();
TestMixedNumericSort();
