enum Option {
    Some(any),
    None
};

enum Result {
    Ok(any),
    Err(any)
};

println("Exhaustive Option & Result Monad Suite");

let stats = [0, 0];

fn pass(name, st) {
    println("  [PASS] " + name);
    st[0] = st[0] + 1;
}

fn fail(name, extra, st) {
    println("  [FAIL] " + name + " (" + extra + ")");
    st[1] = st[1] + 1;
}

fn assert_eq(actual, expected, name, st) {
    if (actual == expected) {
        pass(name, st);
    } else {
        fail(name, "expected " + String(expected) + ", got " + String(actual), st);
    }
}

// Option Monad & Pattern Matching (Option.Some, Option.None)
println("\n1. Option Monad");

let some_val = Option.Some(10);

match (some_val) {
    case Option.Some(v) => { assert_eq(v, 10, "Option.Some(10) value == 10", stats); }
    case Option.None => { fail("Option.Some", "expected Some(10)", stats); }
}

let none_val = Option.None;
match (none_val) {
    case Option.None => { pass("Option.None matched successfully", stats); }
    case Option.Some(v) => { fail("Option.None", "expected None", stats); }
}

// Result Monad & Pattern Matching (Result.Ok, Result.Err)
println("\n2. Result Monad");

let ok_val = Result.Ok(100);
match (ok_val) {
    case Result.Ok(v) => { assert_eq(v, 100, "Result.Ok(100) value == 100", stats); }
    case Result.Err(e) => { fail("Result.Ok", "expected Ok(100)", stats); }
}

let err_val = Result.Err("NetworkFailure");
match (err_val) {
    case Result.Err(e) => { assert_eq(e, "NetworkFailure", "Result.Err preserves error string", stats); }
    case Result.Ok(v) => { fail("Result.Err", "expected Err('NetworkFailure')", stats); }
}

println("Passed: " + String(stats[0]));
println("Failed: " + String(stats[1]));

if (stats[1] == 0) {
    println("All " + String(stats[0]) + " monad tests passed successfully.");
} else {
    println("Test suite failed.");
    exit(1);
}
