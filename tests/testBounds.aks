let arr = [10, 20, 30];

// test out-of-bounds raises exception by default
try {
    let x = arr[5];
    print("Should not reach here");
}catch (e) {
    print("Caught expected bounds exception: " + e);
}

// test out-of-bounds set raises exception by default
try {
    arr[5] = 100;
    print("Should not reach here");
}catch (e) {
    print("Caught expected bounds exception: " + e);
}
