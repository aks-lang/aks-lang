// TestLanguageImprovements.aks - Comprehensive verification of all 5 language improvements

// 1. Tagged Unions / ADTs with :: and . resolution + match pattern destructuring
enum Action {
    Quit,
    Move(int, int),
    Write(string),
    ChangeColor(int, int, int)
};

enum Status {
    Pending,
    Active,
    Done
};

fn TestTaggedUnions() {

    // Test constructor via :: and .
    let q1 = Action::Quit;
    let q2 = Action.Quit;
    assert(q1 != null && q1.$tag == "Action.Quit", "q1.$tag should be Action.Quit");
    assert(q2 != null && q2.$tag == "Action.Quit", "q2.$tag should be Action.Quit");

    let m1 = Action::Move(10, 20);
    let m2 = Action.Move(30, 40);
    assert(m1.field0 == 10 && m1.field1 == 20, "Action::Move fields mismatch");
    assert(m2.field0 == 30 && m2.field1 == 40, "Action.Move fields mismatch");

    let w = Action::Write("aks-lang");
    assert(w.field0 == "aks-lang", "Action::Write field mismatch");

    // Test match destructuring with Action:: variant patterns
    let m_res = match (m1) {
        case Action::Quit => "quit",
        case Action::Move(x, y) => "move:" + String(x) + "," + String(y),
        case Action::Write(s) => "write:" + s,
        case Action::ChangeColor(r, g, b) => "color",
        case _ => "unknown"
    };
    assert(m_res == "move:10,20", "match on Action::Move failed, got: " + String(m_res));

    let q_res = match (q1) {
        case Action::Quit => "quit",
        case Action::Move(x, y) => "move",
        case Action::Write(s) => "write",
        case Action::ChangeColor(r, g, b) => "color",
        case _ => "unknown"
    };
    assert(q_res == "quit", "match on Action::Quit failed, got: " + String(q_res));

    let w_res = match (w) {
        case Action.Quit => "quit",
        case Action.Move(x, y) => "move",
        case Action.Write(s) => "write:" + s,
        case Action.ChangeColor(r, g, b) => "color",
        case _ => "unknown"
    };
    assert(w_res == "write:aks-lang", "match on Action.Write failed, got: " + String(w_res));

    // Test scalar enums with ::
    let s1 = Status::Pending;
    let s2 = Status::Active;
    let s3 = Status::Done;
    assert(s1 == 0, "Status::Pending should be 0");
    assert(s2 == 1, "Status::Active should be 1");
    assert(s3 == 2, "Status::Done should be 2");

    let status_match = match (s2) {
        case Status::Pending => "pending",
        case Status::Active => "active",
        case Status::Done => "done",
        case _ => "other"
    };
    assert(status_match == "active", "match on Status::Active failed");

    // Test Option::Some and Option::None
    let opt_some = Option::Some(42);
    let opt_none = Option::None;
    assert(opt_some.IsSome() == true, "Option::Some should be Some");
    assert(opt_none.IsNone() == true, "Option::None should be None");

    let opt_match = match (opt_some) {
        case Option::Some(val) => val * 2,
        case Option::None => 0
    };
    assert(opt_match == 84, "match on Option::Some failed");

    println("TestTaggedUnions PASSED");
}

// 2. Optional Chaining (?.) and Null Coalescing (??)
fn TestOptionalChainingAndCoalescing() {

    let user = {
        "name": "Anoop",
        "profile": {
            "title": "Systems Architect",
            "scores": [100, 95, 98]
        }
    };

    assert(user?.name == "Anoop", "user?.name should be Anoop");
    assert(user?.profile?.title == "Systems Architect", "user?.profile?.title failed");
    assert(user?.profile?.scores?.[0] == 100, "user?.profile?.scores?.[0] failed");

    // Accessing missing properties should return null without crashing
    assert(user?.missing == null, "user?.missing should be null");
    assert(user?.missing?.nested?.field == null, "user?.missing?.nested?.field should be null");

    // Testing on null base object
    let empty_obj = null;
    assert(empty_obj?.anything == null, "null?.anything should be null");
    assert(empty_obj?.[0] == null, "null?.[0] should be null");

    // Null coalescing ??
    assert((user?.missing ?? "DefaultVal") == "DefaultVal", "user?.missing ?? DefaultVal failed");
    assert((user?.name ?? "DefaultVal") == "Anoop", "user?.name ?? DefaultVal failed");
    assert((empty_obj?.prop ?? 999) == 999, "empty_obj?.prop ?? 999 failed");
    assert((null ?? 42) == 42, "null ?? 42 failed");
    assert((100 ?? 42) == 100, "100 ?? 42 failed");

    println("TestOptionalChainingAndCoalescing PASSED");
}

// 3. High-level HTTP/HTTPS client in prelude/stdlib
fn TestHttpClient() {

    // Test HttpResponse helper methods (.Json(), .Text())
    let mock_resp = new HttpResponse();
    mock_resp.status = 200;
    mock_resp.ok = true;
    mock_resp.body = "{\"status\":\"ok\",\"code\":200}";

    assert(mock_resp.Text() == "{\"status\":\"ok\",\"code\":200}", "mock_resp.Text() failed");
    let parsed_json = mock_resp.Json();
    assert(parsed_json.status == "ok", "mock_resp.Json().status failed");
    assert(parsed_json.code == 200, "mock_resp.Json().code failed");

    // Verify Http struct methods exist
    assert(type(Http.Get) == "function", "Http.Get should be a function");
    assert(type(Http.Post) == "function", "Http.Post should be a function");
    assert(type(Http.PostJson) == "function", "Http.PostJson should be a function");

    println("TestHttpClient PASSED");
}

// 4. First-class Regex prelude class
fn TestRegex() {

    // Constructor syntax
    let re = Regex("\\d+");
    assert(re != null, "Regex constructor should return non-null");
    assert(re.pattern == "\\d+", "re.pattern mismatch");

    // IsMatch / Matches
    assert(re.IsMatch("item 42") == true, "re.IsMatch(\"item 42\") should be true");
    assert(re.IsMatch("no digits") == false, "re.IsMatch(\"no digits\") should be false");

    // Find (first match)
    let first = re.Find("alpha 100 beta 200");
    assert(first == "100", "re.Find should return 100, got: " + String(first));

    let no_match = re.Find("no numbers here");
    assert(no_match == null, "re.Find with no match should return null");

    // FindAll
    let all_matches = re.FindAll("port 8080 and 443 and 22");
    assert(Length(all_matches) == 3, "FindAll should find 3 matches");
    assert(all_matches[0] == "8080", "all_matches[0] should be 8080");
    assert(all_matches[1] == "443", "all_matches[1] should be 443");
    assert(all_matches[2] == "22", "all_matches[2] should be 22");

    // Replace
    let replaced = re.Replace("order 123 completed", "NUMBER");
    assert(replaced == "order NUMBER completed", "re.Replace failed: " + String(replaced));

    // Split
    let split_re = Regex("-");
    let parts = split_re.Split("2026-11-02");
    assert(Length(parts) == 3, "Regex.Split failed length check");
    assert(parts[0] == "2026" && parts[1] == "11" && parts[2] == "02", "Regex.Split parts mismatch");

    // Static Regex methods
    assert(Regex.Match("\\d+", "abc 123") == true, "Regex.Match static failed");
    let static_split = Regex.Split(":", "root:x:0:0");
    assert(Length(static_split) == 4, "Regex.Split static failed");

    println("TestRegex PASSED");
}

// 5. Systems / Bare-metal Hardware I/O aliases
fn TestHardwareIO() {

    // InPortByte / OutPortByte
    let in_val = InPortByte(0x3F8);
    assert(in_val == 0, "InPortByte should return 0");
    OutPortByte(0x3F8, 0x41);

    // VolatileRead / VolatileWrite on allocated memory buffer
    let mem = FreestandingAlloc(64);
    assert(mem != 0, "FreestandingAlloc failed");

    VolatileWrite(mem, 0x123456789ABCDEF0);
    let read_back = VolatileRead(mem);
    assert(read_back == 0x123456789ABCDEF0, "VolatileRead mismatch: " + String(read_back));

    FreestandingFree(mem);
    println("TestHardwareIO PASSED");
}

fn main() {
    TestTaggedUnions();
    TestOptionalChainingAndCoalescing();
    TestHttpClient();
    TestRegex();
    TestHardwareIO();
    println("TestLanguageImprovements PASSED");
}

main();
